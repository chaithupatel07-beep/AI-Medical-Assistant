# ============================================================
# AI Medical Assistant - Environment Configuration Example
# ============================================================
# Copy to backend/.env and configure before starting the server.
# NEVER commit real API keys or secrets to version control.

APP_NAME=AI Medical Assistant
APP_ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Authentication (replace with a strong 32+ character random string in production)
JWT_SECRET_KEY=replace-with-a-strong-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# PostgreSQL / Supabase example:
# DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/ai_medical_assistant
# Default local SQLite database for zero-setup development:
DATABASE_URL=sqlite:///./ai_medical_assistant.db

# Server-Side AI Integration (OpenAI or any OpenAI-compatible API endpoint)
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Optional: Explicit path to Tesseract OCR binary if not on system PATH
TESSERACT_CMD=

# Secure File Storage
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads
