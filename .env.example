# ============================================================
# AI Medical Assistant — Environment Configuration Example
# Zero external API keys required for local offline/Ollama mode!
# ============================================================

# Google AI Studio (Free Tier - Optional for live Gemini 2.5 Flash AI):
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional OpenAI / OpenAI-Compatible Provider (or local Ollama):
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Supabase Project Settings -> API (Free Tier - Optional for cloud Postgres/Storage/Auth):
# https://supabase.com/dashboard
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=medical-files

# Local Database (SQLite works automatically with zero config; use Postgres URL in production):
DATABASE_URL=sqlite:///./ai_medical_assistant.db
JWT_SECRET_KEY=replace-with-a-strong-random-secret-key-at-least-32-chars
