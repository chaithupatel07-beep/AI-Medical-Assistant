APP_NAME=AI Medical Assistant
APP_ENV=development
ENVIRONMENT=development
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_ORIGIN=

JWT_SECRET_KEY=replace-with-a-strong-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL / Supabase / Neon or local SQLite fallback)
# DATABASE_URL=postgresql+psycopg://postgres:your_password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./ai_medical_assistant.db

# Optional Supabase Auth & Private Storage (Server-side only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=medical-files

# Optional Server-Side AI Provider (NOT required — built-in offline engine + optional local Ollama work by default)
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

TESSERACT_CMD=
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads
RATE_LIMIT_PER_MINUTE=120
